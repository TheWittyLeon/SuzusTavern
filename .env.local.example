# .env.local.example — copy to .env.local and fill in.

# Public — exposed to client JS. The DnD/narration proxies read this on the
# server, but the var is also reachable from client code (hence NEXT_PUBLIC_).
# DO NOT "fix" the spelling — NEKANOVA matches the existing proxy + tests.
NEXT_PUBLIC_NEKANOVA_URL=http://localhost:8080

# Server-only — used by the auth BFF (src/app/api/auth/[...path]/route.ts).
# Must NOT be NEXT_PUBLIC_ — refresh/access tokens never reach client JS.
AUTH_API_URL=http://localhost:5000

# Optional — only if a client page links to Authentication-Python's UI directly
# (e.g., a marketing "manage account" link). Safe to omit.
# NEXT_PUBLIC_AUTH_URL=http://localhost:5000

# Public — build-time only (Next inlines it into the client bundle at build,
# not read at runtime). Controls the Codex nav tab/route independently of
# NODE_ENV. Unset defaults to "on outside production, off in production" —
# the pre-existing behaviour. Does NOT affect IS_PROD or the admin/dnd-proxy
# Bearer-fallback security gates, which stay keyed to NODE_ENV only.
# NEXT_PUBLIC_CODEX_ENABLED=true

# Server-only — admin token forwarded to the DnD engine on admin content routes.
# Used by the /api/dnd/admin/* proxy gate (S8.3). MUST match SUZU_DND_ADMIN_TOKEN
# on the engine host. NEVER use NEXT_PUBLIC_* for this — it must not reach the browser.
# The proxy returns 403 before forwarding when the session lacks the 'admin' role.
# When unset, admin routes forward without the header; the engine returns 503 (fails-closed).
SUZU_DND_ADMIN_TOKEN_TAVERN=

# Public — build/start-time. DDX-20 durable generation (config.ts
# DURABLE_GENERATION_ENABLED). Unset/false = the committed, shipped behaviour
# (production). The dev profile (ProjectNekoNova deployment/staging/docker-compose.tavern-dev.yml) sets it true.
# NEXT_PUBLIC_DURABLE_GENERATION_ENABLED=true

# Dev-server only — comma-separated hosts Next 16's dev server accepts
# cross-origin dev requests from (next.config.ts allowedDevOrigins). Needed when
# the dev Tavern is opened by LAN address rather than localhost. Ignored by
# `next build`. Unset = none listed.
# ALLOWED_DEV_ORIGINS=10.69.69.226
